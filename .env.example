# Environment Configuration Example
# Copy to .env for local overrides

# Backend API Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Product Data Provider
# Options: 'fakestore' | 'mock'
PRODUCT_DATA_SOURCE=fakestore
FAKESTORE_API_BASE_URL=https://fakestoreapi.com
FAKESTORE_TIMEOUT_MS=5000
PRODUCT_CACHE_TTL_MS=300000

# Email Notification Provider
# Options: 'smtp' | 'console'
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=noreply@ansrcatalogue.com
SALES_INBOX_EMAIL=sales@ansrcatalogue.com

# Frontend Configuration (used by Vite)
VITE_API_BASE_URL=http://localhost:3001/api
